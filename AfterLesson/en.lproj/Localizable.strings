/* Privacy */
"privacy.title" = "Privacy Policy";
"privacy.updated" = "As of: June 2026";
"privacy.responsible.title" = "Responsible party";
"privacy.responsible.body" = "Grünbuch is operated by Hans Ruffin. For privacy questions, contact us at support@hansruffin.ch.";
"privacy.principle.title" = "Principle";
"privacy.principle.body" = "Grünbuch stores your coaching data exclusively on your device. There are no user accounts, no cloud sync, and no tracking. We do not collect personal data on servers.";
"privacy.local.title" = "Locally stored data";
"privacy.local.body" = "Lessons, sessions, student records, media, notes, and settings remain in the app on your iPhone or iPad. You can share content via AirDrop, Files, or other apps — then the privacy terms of that channel apply.";
"privacy.camera.title" = "Camera";
"privacy.camera.body" = "With your permission, you can capture photos and videos directly in Grünbuch, e.g. for learning content or training documentation. Recordings are stored locally unless you export them yourself.";
"privacy.microphone.title" = "Microphone";
"privacy.microphone.body" = "With your permission, you can record voice notes. Audio data is stored locally in the app and is not transmitted to us.";
"privacy.photos.title" = "Photos";
"privacy.photos.body" = "With your permission, you can include existing images from your photo library in lessons. Grünbuch reads only the photos you select; they are stored locally in the app.";
"privacy.speech.title" = "Speech recognition";
"privacy.speech.body" = "With your permission, Grünbuch can convert spoken training sessions to text. Processing uses Apple's on-device speech recognition; we do not receive transcripts.";
"privacy.biometrics.title" = "Face ID / Touch ID";
"privacy.biometrics.body" = "You can optionally enable screen lock with Face ID or Touch ID. Biometric data stays in your device's Secure Enclave; Grünbuch does not store or access it. Alternatively, you can use a PIN stored securely in your device's keychain.";
"privacy.keychain.title" = "PIN & keychain";
"privacy.keychain.body" = "When you set a PIN or teacher PIN, only a hash value is stored in the iOS keychain. The PIN itself never leaves your device.";
"privacy.rights.title" = "Your rights";
"privacy.rights.body" = "You can delete stored content in the app at any time or uninstall the app to remove all local data. There is no right of access with us, as we do not maintain centrally stored user data.";
"privacy.changes.title" = "Changes";
"privacy.changes.body" = "This privacy policy may be updated as needed. The current version is always available under Settings → Privacy in the app.";

