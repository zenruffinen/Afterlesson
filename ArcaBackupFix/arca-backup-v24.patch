+    private func exportDataAsEncryptedJSON(_ backup: ArcaBackup, to url: URL, password: String) -> URL? {
+        var fileData: [String: Data] = [:]
+        for doc in documents {
+            guard materializeDocumentFile(doc.filename) else { continue }
+            let fileURL = documentURL(for: doc.filename)
+            if let data = try? Data(contentsOf: fileURL) {
+                fileData[doc.filename] = data
+            }
+        }
+        var payload = backup
+        payload.fileData = fileData
+        guard let plaintext = try? JSONEncoder().encode(payload),
+              let encrypted = try? encryptData(plaintext, password: password) else { return nil }
+        try? FileManager.default.removeItem(at: url)
+        do {
+            try encrypted.write(to: url)
+        } catch {
+            return nil
+        }
+        guard FileManager.default.fileExists(atPath: url.path),
+              let size = try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? Int,
+              size > 0 else { return nil }
+        return url
+    }
