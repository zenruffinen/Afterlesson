+    /// Stellt sicher, dass eine Dokument-Datei lokal vorliegt (inkl. kurzem iCloud-Warten).
+    private func materializeDocumentFile(_ filename: String, timeout: TimeInterval = 8) -> Bool {
+        let url = documentURL(for: filename)
+        if FileManager.default.fileExists(atPath: url.path) { return true }
+        _ = ensureFileDownloaded(filename)
+        let deadline = Date().addingTimeInterval(timeout)
+        while Date() < deadline {
+            if FileManager.default.fileExists(atPath: url.path) { return true }
+            if let status = try? url.resourceValues(forKeys: [.ubiquitousItemDownloadingStatusKey])
+                .ubiquitousItemDownloadingStatus,
+               status == .current || status == .downloaded {
+                return FileManager.default.fileExists(atPath: url.path)
+            }
+            Thread.sleep(forTimeInterval: 0.2)
+        }
+        return FileManager.default.fileExists(atPath: url.path)
+    }
